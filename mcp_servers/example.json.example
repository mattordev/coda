{
    "id": "example",
    "transport": "stdio",
    "command": "python",
    "args": ["/absolute/path/to/server.py"],
    "trusted": false,
    "allowed_tools": [],
    "confirm_tools": [],
    "session_mode": "operation",
    "startup_mode": "lazy",
    "idle_timeout_seconds": null,
    "env": {},
    "startup_timeout_seconds": 10,
    "timeout_seconds": 30,
    "max_output_bytes": 4194304,
    "max_tools": 256
}
