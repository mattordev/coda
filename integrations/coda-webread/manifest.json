{
  "id": "webread",
  "version": "1.0.0",
  "entrypoint": "server.py",
  "dependencies": [
    "mcp",
    "idna",
    "certifi"
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "config_file": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "setting_arguments": {
    "config_file": "--config"
  },
  "configuration_files": [
    {
      "setting": "config_file",
      "default": "webread.config.json",
      "schema": {
        "type": "object",
        "properties": {
          "network": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "allowed_hosts": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253
                }
              },
              "allowed_ports": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "max_response_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2097152
              },
              "max_wire_bytes": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 4194304
              },
              "max_redirects": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            },
            "additionalProperties": false
          },
          "extraction": {
            "type": "object",
            "properties": {
              "max_chars": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32000
              },
              "max_links": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
