{
  "network": {
    "enabled": false,
    "allowed_hosts": [],
    "allowed_ports": [
      80,
      443
    ],
    "timeout_seconds": 10,
    "max_response_bytes": 524288,
    "max_wire_bytes": 1048576,
    "max_redirects": 3
  },
  "extraction": {
    "max_chars": 12000,
    "max_links": 10
  }
}
