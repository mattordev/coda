# =============================================================================
# C.O.D.A environment baseline
# =============================================================================
# Copy this file to the project root as .env, then fill in the values for your
# setup. Blank values are safe defaults unless a provider you enable requires
# them.

# =============================================================================
# API keys
# =============================================================================

# Required when OpenAI is included in CODA_CLOUD_PROVIDERS.
OPENAI_API_KEY=

# Required when Gemini is included in CODA_CLOUD_PROVIDERS.
GEMINI_API_KEY=

# Required when Grok is included in CODA_CLOUD_PROVIDERS.
XAI_API_KEY=

# Required when OpenRouter is included in CODA_CLOUD_PROVIDERS.
OPENROUTER_API_KEY=

# Required for ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
CODA_ELEVENLABS_TIMEOUT=30

# =============================================================================
# Speech-to-text
# =============================================================================

# Speech recognition provider: auto, faster-whisper, whisper, or google.
# auto prefers local faster-whisper when installed, then falls back to Google.
CODA_STT_PROVIDER=auto

# Whisper model to load. auto chooses a hardware-friendly default:
# turbo on CUDA, small on desktop CPU, base on ARM boards.
CODA_WHISPER_MODEL=auto

# Whisper language hint. Use en for English-first recognition, or leave blank
# for language auto-detection.
CODA_WHISPER_LANGUAGE=en

# Optional: force the Whisper device. Leave blank to auto-select cuda when
# available, otherwise cpu.
CODA_WHISPER_DEVICE=

# Optional: force the Whisper compute type. Leave blank to use float16 on CUDA
# and int8 on CPU.
CODA_WHISPER_COMPUTE_TYPE=

# Optional: Whisper beam size. Higher can improve accuracy but costs more CPU.
CODA_WHISPER_BEAM_SIZE=5

# Optional: enable faster-whisper voice activity detection filtering.
# Truthy values: 1, true, yes, on. Falsy values: 0, false, no, off.
CODA_WHISPER_VAD_FILTER=1

# =============================================================================
# Voice capture
# =============================================================================

# Seconds of silence before CODA treats the current phrase as finished.
CODA_PAUSE_THRESHOLD=1.2

# Maximum seconds CODA will capture for one spoken phrase.
CODA_PHRASE_TIME_LIMIT=12

# Optional: seconds to wait for speech before returning to the main loop.
CODA_LISTEN_TIMEOUT=3

# Optional: seconds spent calibrating ambient microphone noise on startup.
CODA_CALIBRATION_SECONDS=0.8

# Optional: seconds CODA keeps listening for follow-up speech after an LLM reply.
CODA_FOLLOWUP_TIMEOUT=10

# Optional: print available microphones on startup.
CODA_LIST_MICS_ON_START=0

# Optional: select a microphone by case-insensitive name match.
# Leave blank to use the system default microphone.
CODA_MIC_NAME=

# Optional: select a microphone by numeric index. Takes priority over
# CODA_MIC_NAME when set.
CODA_MIC_INDEX=

# =============================================================================
# LLM provider and models
# =============================================================================

# Ordered cloud providers used first for low-risk requests.
# Only providers registered as "cloud" are valid here.
# Available cloud providers: openai, gemini, grok, openrouter
# Example: openrouter, gemini, grok, openai
CODA_CLOUD_PROVIDERS=openai

# Ordered local providers used for sensitive requests and local fallback.
# Only providers registered as "local" are valid here.
# Available local providers: ollama, llamacpp
# Example: ollama,llamacpp
CODA_LOCAL_PROVIDERS=ollama

# OpenAI chat model to use when the OpenAI provider is selected.
CODA_OPENAI_MODEL=gpt-4o-mini

# Gemini model to use when the Gemini provider is selected.
CODA_GEMINI_MODEL=gemini-3.7-flash

# Grok model to use when the Grok provider is selected.
CODA_GROK_MODEL=grok-4.5

# OpenRouter model to use when the OpenRouter provider is selected
CODA_OPENROUTER_MODEL=

# Enable LLM fallback when no command matches.
CODA_LLM_FALLBACK=1

# Enable local AI intent classification when rule matching fails.
CODA_INTENT_LOCAL_CLASSIFIER=1

# Optional: request timeout in seconds for LLM provider calls.
CODA_LLM_TIMEOUT=45

# Optional: timeout in seconds for Ollama cold starts when the model is not already loaded.
CODA_OLLAMA_COLD_START_TIMEOUT=120

# Optional: number of user/assistant exchanges to keep in conversation memory.
CODA_CONVERSATION_MAX_TURNS=20

# =============================================================================
# Local LLM providers
# =============================================================================

# Optional: Ollama base URL. Used when Ollama is included in local providers.
CODA_OLLAMA_BASE_URL=http://localhost:11434

# Optional: Ollama model name. Leave blank to let CODA choose from local models.
CODA_OLLAMA_MODEL=

# Optional: llama.cpp server base URL.
# Used when llamacpp is included in CODA_LOCAL_PROVIDERS.
CODA_LLAMACPP_BASE_URL=http://localhost:8080

# Optional: llama.cpp model name.
# Leave blank to let CODA resolve the model exposed by the server.
CODA_LLAMACPP_MODEL=

# =============================================================================
# Privacy routing
# =============================================================================

# Privacy mode for cloud fallback decisions:
# strict     = never send medium/high-risk requests to cloud providers
# balanced   = sanitize medium-risk cloud fallback, block high-risk cloud fallback
# permissive = sanitize medium/high-risk cloud fallback
CODA_PRIVACY_MODE=balanced

# Risk thresholds used by privacy routing.
# Requests at or below the low threshold can use cloud first.
# Requests above the high threshold get the strongest protection.
CODA_PRIVACY_LOW_RISK_THRESHOLD=0.3
CODA_PRIVACY_HIGH_RISK_THRESHOLD=0.7

# Cloud handling for medium-risk requests in balanced/permissive mode.
# Valid values: sanitize, summarize, block, raw.
CODA_CLOUD_PRIVACY_ACTION=sanitize

# Cloud fallback handling for high-risk requests.
# In balanced mode this defaults to block. In permissive mode this defaults to sanitize.
# Valid values: sanitize, summarize, block, raw.
CODA_HIGH_RISK_CLOUD_FALLBACK=block

# =============================================================================
# Assistant behavior
# =============================================================================

# Optional: override CODA's default spoken assistant style.
# Run "debug reload" after changing this while CODA is running.
CODA_SYSTEM_PROMPT=

# =============================================================================
# Debugging
# =============================================================================

# Compatibility placeholder for older configs. Current runtime debug logging uses
# CODA_DEBUG below.
CODA_DEBUG_MODE=0

# Runtime debug logging flag.
CODA_DEBUG=0